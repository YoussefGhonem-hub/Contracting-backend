        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": { "expression": "Whitelisted = true or @Level >= Error" }
              }
            ],
            "WriteTo": [
              {
                "Name": "Async",
                "Args": {
                  "configure": [
                    {
                      "Name": "Seq",
                      "Args": {
                        "serverUrl": "http://localhost:5341",
                        "apiKey": ""
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    ]

  "RequestLogging": {
    "LogExceptions": true,
    "LogAllRequests": true, // summaries only for whitelisted paths
    "EnableBodyLoggingForRequests": true, // no bodies in normal request logs
    "EnableBodyLoggingForExceptions": true, // include request body only on exceptions (whitelisted + text)
    "PathGlobsForRequests": [], // whitelist (important!)
    "DenyPathsForRequests": [ "/health", "/metrics" ], // silence these prefixes
    "TextContentTypes": [ "application/json", "text/" ],
    "BodySizeLimitBytes": 32768,
    "SensitiveKeys": [ "password", "token", "authorization", "client_secret" ]

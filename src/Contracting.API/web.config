<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!--
        Large file uploads (100MB+) were timing out. Two IIS-level defaults were too small:
          - requestLimits maxAllowedContentLength defaults to ~28.6MB (30,000,000 bytes) and rejects
            anything larger before the request even reaches the app.
          - The ASP.NET Core Module (ANCM) forwards requests to the app with its own requestTimeout,
            default 2 minutes — too short for a large/slow upload.
        Raised to 500MB / 20 minutes respectively. Kestrel-side limits are configured in Program.cs.
      -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="524288000" />
        </requestFiltering>
      </security>
      <aspNetCore processPath="dotnet" arguments=".\Contracting.API.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="OutOfProcess" requestTimeout="00:20:00" />
    </system.webServer>
  </location>
</configuration>
